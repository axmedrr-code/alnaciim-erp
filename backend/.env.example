PORT=4000
DATABASE_URL=postgres://alnaciim:alnaciim_dev_pw@localhost:55432/alnaciim_erp
# Set to "true" for managed Postgres (Railway/Render/Fly/Neon/Supabase) — required
# for their external connections. Leave unset/false for a local/self-hosted Postgres.
DATABASE_SSL=false
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed frontend origins in production, e.g.
# https://app.alnaciim.com,https://pos.alnaciim.com
# Leave unset in local dev to allow all origins (the current default).
CORS_ORIGIN=

# Directory containing pg_dump/pg_restore. Leave blank if they're already on PATH
# (e.g. inside the official postgres Docker image).
PG_BIN_PATH=

# Cron expression for the automatic daily backup (default: 2am server time).
BACKUP_CRON_SCHEDULE=0 2 * * *

# Local backup files older than this are deleted automatically after each backup run.
BACKUP_RETENTION_DAYS=30
