# RO System Engineering Calculator – local configuration
# Copy this file to ".env" to change the defaults. Nothing here connects to the internet.

# Port of the local web server (open http://localhost:PORT in your browser)
PORT=3000

# Network interface. 127.0.0.1 = only this computer can open the app (recommended).
# Use 0.0.0.0 only if you deliberately want other PCs on your LAN to reach it.
HOST=127.0.0.1

# Location of the local SQLite database file (relative to the project folder)
DATABASE_PATH=./data/ro-calculator.db

# Create the "30 m³/h RO System" sample project on first start (true/false)
SEED_SAMPLE=true
