# Full base URL of the deployed backend API, including the /api/v1 prefix.
# Leave unset for local dev — Vite's own proxy (vite.config.js) forwards
# relative /api/v1 requests to http://localhost:4000 instead.
# This is read at BUILD time, so changing it on Vercel needs a redeploy.
#
# Production (Railway fallback):  VITE_API_URL=https://<railway-backend>/api/v1
# TEST (Render):                  VITE_API_URL=https://<alnaciim-erp-test-api>.onrender.com/api/v1
VITE_API_URL=https://api.alnaciim.com/api/v1
